{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "module": "nodenext",
    "target": "es2022",
    "lib": ["es2022"], // Add this for modern JS features
    "skipLibCheck": true,
    
    // REMOVE "types": [] or change it to:
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@prisma/client": ["node_modules/@prisma/client"]
} 
  },
  "include": ["src/**/*"]
}