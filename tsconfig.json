{
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./dist",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "ignoreDeprecations": "6.0",

    "module": "nodenext",
    "target": "es2022",
    "lib": ["es2022"], 
    "skipLibCheck": true,
    
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@prisma/client": ["./generated/prisma"]
} 
  },
  "include": ["src/**/*", "prisma.config.ts", "prisma/seed.ts"]
}